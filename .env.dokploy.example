# Copie estas variáveis para a aba Environment do Dokploy.
# Não versione uma cópia preenchida com senhas ou chaves reais.

COMPOSE_PROJECT_NAME=synapse

API_GATEWAY_PORT=8080
PROFILE_SERVICE_PORT=8081
PROJECT_SERVICE_PORT=8082
MATCH_ORCHESTRATOR_PORT=8083
ML_ENGINE_PORT=8000

# O frontend e o Gateway usam o mesmo domínio no Dokploy.
NEXT_PUBLIC_API_BASE_URL=/api
APP_PUBLIC_URL=https://synapse.rafixx.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://synapse.rafixx.com

# Assistente de escrita. Preencha a chave no Dokploy ou use LLM_PROVIDER=mock.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_COOLDOWN_HOURS=24
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Conta administrativa inicial. Use uma senha forte.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrador
ADMIN_METRICS_TIMEZONE=America/Sao_Paulo

# SMTP de produção. Não publique o Mailpit na internet.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@rafixx.com
PASSWORD_RESET_EXPIRATION_MINUTES=30

POSTGRES_VERSION=16-alpine

POSTGRES_PROFILE_DB=profile_service
POSTGRES_PROFILE_USER=profile_user
POSTGRES_PROFILE_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA

POSTGRES_PROJECT_DB=project_service
POSTGRES_PROJECT_USER=project_user
POSTGRES_PROJECT_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA

POSTGRES_MATCH_DB=match_orchestrator
POSTGRES_MATCH_USER=match_user
POSTGRES_MATCH_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA

REDIS_VERSION=7-alpine
REDIS_PORT=6379
