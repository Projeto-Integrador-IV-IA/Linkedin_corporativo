COMPOSE_PROJECT_NAME=linkedin-corporativo

API_GATEWAY_PORT=8080
PROFILE_SERVICE_PORT=8081
PROJECT_SERVICE_PORT=8082
MATCH_ORCHESTRATOR_PORT=8083
ML_ENGINE_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Opcional: chave temporária para redefinir senha via operação administrativa.
# Remova/desconfigure após o uso.
AUTH_RESET_KEY=

POSTGRES_VERSION=16-alpine

POSTGRES_PROFILE_DB=profile_service
POSTGRES_PROFILE_USER=profile_user
POSTGRES_PROFILE_PASSWORD=change-me-profile

POSTGRES_PROJECT_DB=project_service
POSTGRES_PROJECT_USER=project_user
POSTGRES_PROJECT_PASSWORD=change-me-project

POSTGRES_MATCH_DB=match_orchestrator
POSTGRES_MATCH_USER=match_user
POSTGRES_MATCH_PASSWORD=change-me-match

REDIS_VERSION=7-alpine
REDIS_PORT=6379
