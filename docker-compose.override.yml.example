# Copie este arquivo para docker-compose.override.yml apenas quando precisar
# executar ou depurar os serviços diretamente pelo host. O arquivo real é
# ignorado pelo Git. O uso normal deve continuar passando pelo API Gateway.
# Crie também a rede usada em produção uma única vez com:
# docker network create servidor_net

services:
  api-gateway:
    ports:
      - "${API_GATEWAY_PORT}:${API_GATEWAY_PORT}"

  frontend:
    ports:
      - "3000:3000"

  profile-service:
    ports:
      - "${PROFILE_SERVICE_PORT}:${PROFILE_SERVICE_PORT}"

  project-service:
    ports:
      - "${PROJECT_SERVICE_PORT}:${PROJECT_SERVICE_PORT}"

  match-orchestrator:
    ports:
      - "${MATCH_ORCHESTRATOR_PORT}:${MATCH_ORCHESTRATOR_PORT}"

  ml-engine:
    ports:
      - "${ML_ENGINE_PORT}:${ML_ENGINE_PORT}"

  mailpit:
    ports:
      - "8025:8025"
